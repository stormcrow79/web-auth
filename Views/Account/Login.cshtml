@model WebAuth.Models.LoginViewModel

@{
    ViewBag.Title = "Log In";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title mb-4">@ViewBag.Title</h3>

                <!-- Local Login Form -->
                <div class="mb-4">
                    <h5>Login with Demo Account</h5>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                foreach (var error in modelState.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Enter username" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.RememberMe, "Remember me?", new { @class = "form-check-label" })
                        </div>

                        <button type="submit" class="btn btn-primary">Log In</button>
                    }

                    <p class="text-muted mt-3 mb-0">
                        <strong>Demo Credentials:</strong><br>
                        Username: <code>demo</code><br>
                        Password: <code>password</code>
                    </p>
                </div>

                <hr class="my-4" />

                <!-- Auth0 Login Option -->
                <div>
                    <h5>Or Login with Auth0</h5>
                    <p class="text-muted">Use your Auth0 account for secure authentication</p>
                    @Html.ActionLink("Login with Auth0", "LoginAuth0", "Account",
                        new { returnUrl = ViewBag.ReturnUrl },
                        new { @class = "btn btn-outline-primary" })
                </div>
            </div>
        </div>
    </div>
</div>
